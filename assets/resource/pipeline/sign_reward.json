            "type": "ColorMatch",
            "param": {
                "roi": [
                    0,
                    0,
                    1280,
                    720
                ],
                "method": 4,
                "lower": [
                    190,
                    198,
                    202
                ],
                "upper": [
                    204,
                    212,
                    216
                ],
                "count": 100
            }
        },
        "timeout": 5000,
        "rate_limit": 500,
        "on_error": [
            "sign_check_obstruction"
