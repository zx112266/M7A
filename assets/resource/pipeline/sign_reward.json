{
    "sign_check_reward": {
        "desc": "尝试识别签到奖励弹窗",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    179,
                    36,
                    536,
                    100
                ],
                "expected": [
                    "签到奖励"
                ]
            }
        },
        "timeout": 5000,
        "rate_limit": 500,
        "on_error": [
            "sign_check_obstruction"
        ],
        "next": [
            "sign_close_reward"
        ]
    },
    "sign_close_reward": {
        "desc": "关闭签到奖励弹窗",
