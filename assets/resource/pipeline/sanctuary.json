{
    "detect_san_entrance": {
        "desc": "识别圣域入口",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "sanctuary_main/san_entrance.png"
                ],
                "roi": [
                    0,
                    0,
                    1280,
                    720
                ],
                "threshold": 0.82
            }
        },
        "timeout": 6000,
        "pre_wait_freezes": 400,
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    60,
                    170
                ]
            }
        },
        "repeat": 1,
        "repeat_delay": 2000,
        "next": [
            "wait_page_render"
        ]
    },
    "wait_page_render": {
        "desc": "等待页面渲染",
        "recognition": "DirectHit",
