        "desc": "关闭增益效果弹窗，点击3次",
        "recognition": "DirectHit",
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    327,
                    16
                ]
            }
        },
        "repeat": 3,
        "repeat_delay": 500,
