{
    "start_game": {
        "action": {
            "type": "StartApp",
            "param": {
                "package": "com.zlongame.cn.epicseven.bilibili"
            }
        },
        "next": [
            "wait_game_load"
        ]
    },
    "wait_game_load": {
        "timeout": 35000,
        "pre_wait_freezes": 2000,
        "rate_limit": 1000,
        "on_error": [
            "wait_main_ui"
        ],
        "next": [
            "close_notice_pop"
        ]
    },
    "close_notice_pop": {
        "recognition": "OCR",
        "expected": "官方公告",
        "timeout": 5000,
        "rate_limit": 1000,
        "on_error": [
            "wait_main_ui"
        ],
        "action": {
            "type": "Click",
            "target": [
                1137,
                77
            ]
        },
        "next": [
            "check_ad_pop"
        ]
    },
    "check_ad_pop": {
        "recognition": "OCR",
        "expected": "不再展示",
        "roi": [
            359,
            546,
            153,
            34
        ],
        "timeout": 3000,
        "rate_limit": 1000,
        "on_error": [
            "wait_main_ui"
        ],
        "next": [
            "click_checkbox"
        ]
    },
    "click_checkbox": {
        "recognition": "DirectHit",
        "action": {
            "type": "Click",
            "target": [
                335,
                560
            ]
        },
        "next": [
            "close_ad"
        ]
    },
    "close_ad": {
        "recognition": "DirectHit",
        "action": {
            "type": "Click",
            "target": [
                1003,
                203
            ]
        },
        "next": [
            "wait_main_ui"
        ]
    },
    "wait_main_ui": {
        "timeout": 35000,
        "pre_wait_freezes": 2000,
        "rate_limit": 1000,
        "on_error": [
            "all_end"
        ],
        "next": [
            "touch_start_game"
        ]
    },
    "touch_start_game": {
        "recognition": "OCR",
        "expected": "轻触画面开始",
        "action": {
            "type": "Click",
            "target": [
                640,
                360
            ]
        },
        "repeat": 3,
        "repeat_delay": 500,
        "next": [
            "wait_after_login"
        ]
    },
    "wait_after_login": {
        "recognition": "DirectHit",
        "action": "DoNothing",
        "pre_wait_freezes": 7000,
        "wait_freezes_param": {
            "timeout": 15000
        },
        "next": [
            "all_end"
        ]
    },
    "all_end": {
        "recognition": "DirectHit",
        "action": "DoNothing"
    }
}