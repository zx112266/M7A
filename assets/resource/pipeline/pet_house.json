{
    "detect_pet_house": {
        "desc": "识别宠物小屋入口",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    773,
                    620,
                    74,
                    72
                ],
                "expected": [
                    "宠物小屋"
                ]
            }
        },
        "timeout": 5000,
        "on_error": [
            "pet_back_to_lobby"
        ],
        "next": [
            "click_pet_house"
        ]
    },
    "click_pet_house": {
        "desc": "点击宠物小屋",
        "recognition": "DirectHit",
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    804,
                    650
                ]
            }
        },
        "next": [
            "wait_pet_load"
        ]
    },
    "wait_pet_load": {
        "desc": "等待界面加载",
        "recognition": "DirectHit",
        "action": "DoNothing",
        "timeout": 5000,
        "rate_limit": 1000,
        "on_error": [
            "pet_back_to_lobby"
        ],
        "next": [
            "dot_check"
        ]
    },
    "dot_check": {
        "desc": "检测宠物小屋红点",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "sanctuary_main/dot_forest.png",
                "roi": [
                    772,
                    625,
                    40,
                    35
                ],
                "threshold": 0.82
            }
        },
        "next": [
            "click_dot"
        ]
    },
    "click_dot": {
        "desc": "点击红点",
        "recognition": "DirectHit",
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    858,
                    659
                ]
            }
        },
        "timeout": 3000,
        "rate_limit": 1000,
        "on_error": [
            "pet_back_to_lobby"
        ],
        "next": [
            "judge_free"
        ]
    },
    "judge_free": {
        "desc": "识别免费领养",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    420,
                    597,
                    52,
                    30
                ],
                "expected": [
                    "免费"
                ]
            }
        },
        "next": [
            "click_free"
        ]
    },
    "click_free": {
        "desc": "点击免费领养",
        "recognition": "DirectHit",
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    520,
                    609
                ]
            }
        },
        "timeout": 3000,
        "rate_limit": 1000,
        "on_error": [
            "pet_back_to_lobby"
        ],
        "next": [
            "judge_result"
        ]
    },
    "judge_result": {
        "desc": "识别领养结果",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    561,
                    67,
                    152,
                    70
                ],
                "expected": [
                    "领养结果"
                ]
            }
        },
        "next": [
            "click_blank"
        ]
    },
    "click_blank": {
        "desc": "点击空白关闭弹窗，点击2次",
        "recognition": "DirectHit",
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    57,
                    88
                ]
            }
        },
        "repeat": 2,
        "repeat_delay": 500,
        "next": [
            "pet_back_to_lobby"
        ]
    },
    "no_dot_click": {
        "desc": "无红点时点击关闭，点击3次",
        "recognition": "DirectHit",
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    317,
                    25
                ]
            }
        },
        "repeat": 3,
        "repeat_delay": 1000,
        "next": [
            "pet_back_to_lobby"
        ]
    },
    "pet_back_to_lobby": {
        "desc": "返回大厅循环",
        "timeout": 60000,
        "rate_limit": 500,
        "on_error": [
            "pet_task_end"
        ],
        "next": [
            "pet_flag_in_lobby",
            "[JumpBack]pet_click_back"
        ]
    },
    "pet_flag_in_lobby": {
        "desc": "识别大厅界面",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    1161,
                    371,
                    87,
                    39
                ],
                "expected": [
                    "竞技场"
                ]
            }
        },
        "next": [
            "pet_task_end"
        ]
    },
    "pet_click_back": {
        "desc": "点击返回按钮",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    12,
                    9,
                    54,
                    49
                ],
                "template": [
                    "back_button.png"
                ],
                "threshold": 0.8
            }
        },
        "action": {
            "type": "Click",
            "param": {}
        },
        "pre_delay": 1000,
        "post_delay": 2000
    },
    "pet_task_end": {
        "desc": "流程结束",
        "recognition": "DirectHit",
        "action": "DoNothing"
    }
}