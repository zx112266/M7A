        "action": {
            "type": "Click",
            "param": {
                "target": [
                    1063,
                    681
                ]
            }
        },
        "post_delay": 1500,
        "post_wait_freezes": {
            "time": 500,
            "target": [
                0,
                0,
                1280,
                720
            ]
        },
        "next": [
            "sign_check_obstruction"
        ]
    },
    "sign_check_obstruction": {
        "desc": "检测其他弹窗遮挡（深色状态）",
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [
                    0,
                    0,
                    1280,
                    720
                ],
                "method": 4,
                "lower": [
                    49,
                    50,
                    51
                ],
                "upper": [
                    63,
                    64,
                    65
                ],
                "count": 100
            }
        },
        "timeout": 3000,
        "rate_limit": 500,
        "on_error": [
            "sign_check_lobby"
        ],
        "next": [
            "sign_check_buff"
        ]
    },
    "sign_check_buff": {
        "desc": "识别增益效果弹窗",
